# Copy this file to .env and fill in the values.
# See README.md > "Environment Variables" for the full description of each.

# ─── Database (Supabase PostgreSQL) ────────────────────────────────
DATABASE_URL=
DIRECT_URL=

# ─── Supabase Storage ───────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Auth (NextAuth / Auth.js v5) ───────────────────────────────────
AUTH_SECRET=
AUTH_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=

# ─── AI SEO formatting (DeepSeek) — optional ────────────────────────
DEEPSEEK_API_KEY=

# ─── Icecat product data lookup by EAN — optional ───────────────────
ICECAT_USERNAME=
ICECAT_KEY=

# ─── PrestaShop migration (migration/README.md) — optional ─────────
MYSQL_HOST=
MYSQL_PORT=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
PS_PREFIX=
PS_LANG_ID=
PS_SITE_URL=
SUPABASE_BUCKET=
IMG_CONCURRENCY=
DRY_RUN=
FORCE=
