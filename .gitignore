# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# ── PrestaShop migration ──────────────────────────────────────────
# Never commit production dumps (can be hundreds of MB).
# The structural schema (01-prestashop-schema.sql) IS tracked — everything
# else under migration/mysql-init/ (dumps, gz, bak) stays local.
migration/mysql-init/*
!migration/mysql-init/01-prestashop-schema.sql
migration/*.sql
migration/*.sql.gz
migration/*.dump
migration/*.bak
